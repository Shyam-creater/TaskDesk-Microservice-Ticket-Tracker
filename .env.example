# ==============================================================================
# TaskDesk Environment Variables Example
# ==============================================================================

# Common
NODE_ENV=development
JWT_SECRET=supersecret_jwt_signing_key_at_least_32_characters_long_for_security
JWT_EXPIRES_IN=1h

# Services Ports
GATEWAY_PORT=4000
AUTH_PORT=4001
TICKET_PORT=4002
FRONTEND_PORT=5173

# Service URLs (for Gateway and Inter-Service Communication)
AUTH_SERVICE_URL=http://localhost:4001
TICKET_SERVICE_URL=http://localhost:4002
API_GATEWAY_URL=http://localhost:4000

# Docker Internal Service URLs (used inside docker-compose)
# AUTH_SERVICE_URL=http://auth-service:4001
# TICKET_SERVICE_URL=http://ticket-service:4002
# API_GATEWAY_URL=http://api-gateway:4000

# Database URIs
# Non-Docker (Local MongoDB)
AUTH_MONGO_URI=mongodb://localhost:27017/auth_db
TICKET_MONGO_URI=mongodb://localhost:27017/ticket_db

# Docker Compose URIs (uncomment in docker environment)
# AUTH_MONGO_URI=mongodb://mongo:27017/auth_db
# TICKET_MONGO_URI=mongodb://mongo:27017/ticket_db

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# In Docker: http://jaeger:4318/v1/traces
LOG_LEVEL=info

# Frontend Configuration
VITE_API_URL=http://localhost:4000/api
