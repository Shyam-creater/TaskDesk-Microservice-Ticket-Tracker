# ==============================================================================
# TaskDesk Microservices Environment Variables Example
# ==============================================================================

# Gateway & Service Ports
PORT=4000
AUTH_SERVICE_PORT=4001
TICKET_SERVICE_PORT=4002
NOTIFICATION_SERVICE_PORT=4003

# Internal Service URLs
AUTH_SERVICE_URL=http://localhost:4001
TICKET_SERVICE_URL=http://localhost:4002
NOTIFICATION_SERVICE_URL=http://localhost:4003

# Security & Shared Secrets
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d
INTERNAL_SERVICE_KEY=your_internal_service_mesh_secret_key

# MongoDB Database Connection
# Reviewers can provide their own Atlas URI or local MongoDB (e.g. mongodb://localhost:27017)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.rfz95.mongodb.net/?retryWrites=true&w=majority

# Frontend Configuration
VITE_API_URL=http://localhost:4000/api
